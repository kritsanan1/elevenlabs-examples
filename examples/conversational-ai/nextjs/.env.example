# ElevenLabs Conversational AI Demo - Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================================================
# ELEVENLABS CONFIGURATION (REQUIRED)
# ================================================================

# Your ElevenLabs API key
# Get this from: https://elevenlabs.io/app/speech-synthesis/text-to-speech
# Required for: Voice synthesis, conversation API access
# Format: sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=your_api_key_here

# ElevenLabs Conversational AI Agent ID
# Get this from: https://elevenlabs.io/app/conversational-ai
# Required for: Conversation sessions and voice interactions
# Format: agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_ID=your_agent_id_here

# ================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ================================================================

# Application environment
# Options: development, production, test
# Default: development
NODE_ENV=development

# Next.js configuration
# Disable telemetry data collection
# Options: 1 (disable), 0 (enable)
NEXT_TELEMETRY_DISABLED=1

# Enable debug mode for verbose logging
# Options: true, false
# Default: false
DEBUG=false

# ================================================================
# DEVELOPMENT CONFIGURATION (OPTIONAL)
# ================================================================

# Development server port
# Default: 3000
# Format: number
PORT=3000

# Development server hostname
# Default: localhost
# Options: localhost, 0.0.0.0 (all interfaces)
HOSTNAME=localhost

# ================================================================
# FEATURE FLAGS (OPTIONAL)
# ================================================================

# Enable advanced features
# Options: true, false
# Default: true
ENABLE_ADVANCED_FEATURES=true

# Enable voice commands feature
# Options: true, false
# Default: true
ENABLE_VOICE_COMMANDS=true

# Enable conversation analytics
# Options: true, false
# Default: true
ENABLE_ANALYTICS=true

# Enable export functionality
# Options: true, false
# Default: true
ENABLE_EXPORT=true

# ================================================================
# SECURITY CONFIGURATION (OPTIONAL)
# ================================================================

# CORS allowed origins (for production)
# Format: comma-separated URLs
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Session secret for any future session management
# Generate with: openssl rand -base64 32
# Required for: Session security
SESSION_SECRET=your_session_secret_here

# ================================================================
# MONITORING & ANALYTICS (OPTIONAL)
# ================================================================

# Sentry DSN for error tracking
# Get from: https://sentry.io
# Format: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_DSN=

# Google Analytics tracking ID
# Format: G-XXXXXXXXXX or UA-XXXXXXXXX-X
GOOGLE_ANALYTICS_ID=

# PostHog API key for product analytics
# Get from: https://posthog.com
POSTHOG_API_KEY=

# ================================================================
# PERFORMANCE CONFIGURATION (OPTIONAL)
# ================================================================

# Maximum conversation duration (in minutes)
# Default: 60
# Format: number
MAX_CONVERSATION_DURATION=60

# Audio quality setting
# Options: low, medium, high
# Default: high
AUDIO_QUALITY=high

# Enable audio compression
# Options: true, false
# Default: true
ENABLE_AUDIO_COMPRESSION=true

# ================================================================
# DEPLOYMENT CONFIGURATION (PRODUCTION)
# ================================================================

# Production domain
# Required for: CORS, redirects, canonical URLs
NEXT_PUBLIC_DOMAIN=https://yourdomain.com

# CDN URL for static assets
# Optional: For performance optimization
CDN_URL=

# Database URL (if adding persistence)
# Format: postgresql://user:password@localhost:5432/database
DATABASE_URL=

# ================================================================
# EXTERNAL SERVICES (OPTIONAL)
# ================================================================

# OpenAI API Key (for additional AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Redis URL (for caching/session storage)
# Format: redis://localhost:6379 or redis://user:password@host:port
REDIS_URL=

# AWS Configuration (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ================================================================
# SECURITY HEADERS (PRODUCTION)
# ================================================================

# Content Security Policy
# Customize based on your security requirements
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline';"

# ================================================================
# EXAMPLES AND TESTING
# ================================================================

# Example configuration for different environments:

# DEVELOPMENT:
# ELEVENLABS_API_KEY=sk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_ID=agent_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NODE_ENV=development
# DEBUG=true

# STAGING:
# ELEVENLABS_API_KEY=sk_staging_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_ID=agent_staging_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NODE_ENV=production
# NEXT_PUBLIC_DOMAIN=https://staging.yourdomain.com

# PRODUCTION:
# ELEVENLABS_API_KEY=sk_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_ID=agent_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NODE_ENV=production
# NEXT_PUBLIC_DOMAIN=https://yourdomain.com
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ================================================================
# NOTES AND SECURITY CONSIDERATIONS
# ================================================================

# SECURITY WARNINGS:
# - Never commit this file with real values to version control
# - Use different API keys for development, staging, and production
# - Rotate API keys regularly
# - Restrict API key permissions to minimum required
# - Use environment-specific configurations

# ELEVENLABS SETUP GUIDE:
# 1. Sign up at https://elevenlabs.io
# 2. Navigate to Settings > API Keys
# 3. Create a new API key
# 4. Go to Conversational AI section
# 5. Create or select an agent
# 6. Copy the Agent ID from the agent details

# TESTING CONFIGURATION:
# For testing, you can use the same development credentials
# or create separate test environment keys

# TROUBLESHOOTING:
# - Ensure API keys are correctly formatted
# - Check that Agent ID exists and is active
# - Verify API key has necessary permissions
# - Test API access with curl or Postman first

# ================================================================
# VALIDATION CHECKLIST
# ================================================================

# Before deploying, ensure:
# ✅ ELEVENLABS_API_KEY is set and valid
# ✅ AGENT_ID is set and corresponds to an active agent
# ✅ NODE_ENV is appropriate for the environment
# ✅ No test/development values in production
# ✅ All required variables for your features are set
# ✅ Security configurations are appropriate
# ✅ Performance settings are optimized for your use case
